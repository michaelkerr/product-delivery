#!/usr/bin/env python3
"""Thin wrapper — prefer `product-delivery setup` or MCP workflow_setup."""

import sys
from pathlib import Path

_src = Path(__file__).resolve().parent.parent / "src"
if _src.exists():
    sys.path.insert(0, str(_src))

from product_delivery.setup import run_setup  # noqa: E402


def main():
    project = Path.cwd()
    args = sys.argv[1:]
    if "--dir" in args:
        idx = args.index("--dir")
        if idx + 1 < len(args):
            project = Path(args[idx + 1]).resolve()
    run_setup(project)


if __name__ == "__main__":
    main()
